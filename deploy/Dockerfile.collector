# Build stage
FROM golang:1.27.1-alpine@sha256:cd9a32216aee5667f957a62d13a10032a63fd58e14b3f3d9cc8c2122f501e95e AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /collector ./cmd/collector

# Runtime stage
FROM alpine:3.21@sha256:a8560b36e8b8210634f77d9f7f9efd7ffa463e380b75e2e74aff4511df3ef88c
RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 10001 -S sims && \
    adduser -u 10001 -S -G sims -h /app -s /sbin/nologin sims
USER 10001:10001
WORKDIR /app
COPY --from=builder --chown=10001:10001 /collector /app/collector
EXPOSE 8081
ENTRYPOINT ["/app/collector"]

