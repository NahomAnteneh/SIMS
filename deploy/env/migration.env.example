# SIMS Database Migration Environment Configuration
# Location: /etc/sims/migration.env (Permissions: 0600, Owner: sims:sims)

# PostgreSQL connection using migration_owner credentials (required for goose)
MIGRATION_DATABASE_URL=postgres://migration_owner:<REPLACE_WITH_MIGRATION_OWNER_PASSWORD>@127.0.0.1:5432/sims?sslmode=disable
