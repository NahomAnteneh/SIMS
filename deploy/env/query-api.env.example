# SIMS Query API Environment Configuration
# Location: /etc/sims/query-api.env (Permissions: 0600, Owner: sims:sims)

PORT=8080
LOG_LEVEL=info

# PostgreSQL connection using query_ro credentials (required)
DATABASE_URL=postgres://query_ro:<REPLACE_WITH_QUERY_RO_PASSWORD>@127.0.0.1:5432/sims?sslmode=disable

# Authentication & JWT Configuration
AUTH_ENABLED=true
# 32+ character random secret for signing JWT session tokens
JWT_SECRET=<REPLACE_WITH_32_CHAR_RANDOM_SECRET>

# Initial admin password for first startup bootstrap (leave blank to auto-generate)
ADMIN_INITIAL_PASSWORD=

# CORS Configuration (optional, restrictive by default)
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# Enterprise OIDC (optional)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
