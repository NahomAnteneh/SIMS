# SIMS Collector Environment Configuration
# Location: /etc/sims/collector.env (Permissions: 0600, Owner: sims:sims)

PORT=8081
LOG_LEVEL=info

# PostgreSQL connection using single database user credentials (required)
DATABASE_URL=postgres://sims:<REPLACE_WITH_DB_PASSWORD>@127.0.0.1:5432/sims?sslmode=disable

# Optional bootstrap vCenter (leave blank if registering via UI/API)
VCENTER_URL=
VCENTER_USER=
VCENTER_PASSWORD=
VCENTER_INSECURE=false

# Ingestion Intervals & Keepalive Tuning
SYNC_INTERVAL=30s
SIMS_COLLECTOR_KEEPALIVE_INTERVAL=60s
SIMS_COLLECTOR_KEEPALIVE_TIMEOUT=10s
SIMS_COLLECTOR_KEEPALIVE_MAX_FAILURES=2
SIMS_COLLECTOR_MAX_STREAM_BLOCK_DURATION=5m
